# ---- Node / Electron ----
# 注意：带斜杠的规则必须写全路径，否则只匹配仓库根目录那一层
node_modules/
npm-debug.log*
npm-install.log
electron-dl.log
MDReader/desktop/release*/
MDReader/desktop/.buildcache/
# 浏览器测试 profile（验证脚本现在改用系统临时目录，这些是历史残留）
MDReader/desktop/.e*/
MDReader/desktop/*.log

# ---- 桌面壳的渲染副本：全部由 scripts/sync-app.py 从 dist/ 生成，不入库 ----
# `npm start` / `npm run build:*` 都会先跑 sync，因此 clone 后无需手工处理
MDReader/desktop/app/
MDReader/desktop/app/_autoload.js

# ---- iOS PWA 生成物与浏览器测试 profile ----
MDReader/ios/site/
MDReader/ios/.epwa/
MDReader/ios/.e[0-9]*/

# ---- 构建产物（保留 dist/ 里的成品，忽略临时注入文件）----
MDReader/dist/_*
MDReader/dist/.edge*/
MDReader/src/.edge*/
MDReader/src/.e[0-9]*/
MDReader/src/.es*/
MDReader/src/.ef*/
MDReader/src/.et*/
MDReader/src/_*
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 本地验证脚本产生的副本 ----
*_verify*.html
*_test.html
*.zip.local

# ---- 打包产物：由 tools/pack-portable.py 与 ios/build-pwa.py 生成，不入库 ----
MDReader-Windows11便携版.zip
MDReader-iOS-PWA.zip
MDReader-*.zip

# 发版产物统一输出目录（含 100 MB 级 exe，绝不能入库）
发布包/

# ---- 用户数据 / 临时 ----
_autoload.js
.DS_Store
Thumbs.db
desktop.ini
*.log

# ---- IDE ----
.vscode/
.idea/
*.swp

# ---- 工作区私有目录 ----
.workbuddy/
.finalcheck/
.finalcheck2/
