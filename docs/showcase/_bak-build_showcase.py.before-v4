# 对比表：行 = 能力，列 = 工具
COMPARE_HEAD = ['能力', 'MD Reader', 'Typora', 'Obsidian', 'VS Code', '在线转换站']
COMPARE = [
    ['离线可读、零上传', '单 HTML，0 请求', '桌面应用', '桌面应用', '桌面应用', '❌ 需上传'],
