# -*- coding: utf-8 -*-
"""生成 MD Reader 功能展示页（单文件 HTML，截图 base64 内嵌）。

运行：python docs/showcase/build_showcase.py
输出：docs/showcase/MDReader-功能展示.html

页面结构对标 GitHub 高星项目（excalidraw / marktext / starship）的 README 范式：
  Hero（logo + 价值主张 + 徽章 + CTA）
  → Showcase（3D Cover Flow 轮播，动效保持原样）
  → Features（能力网格，点格直达对应轮播卡）
  → Compare（能力对比表）
  → QuickStart（三形态下载）
  → Footer

截图素材口径（CR-2026-11-18-02）：
  · 弃用 mono 黑白极简（缩略图下辨识度太低），统一 tech 蓝 / cute 粉；
  · 统一 card 卡片布局；
  · 全部按 DOM 实测矩形 clip 成 16:10，contain 下无裁切无大片留白。
"""
import base64
import json
from pathlib import Path

