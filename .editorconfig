root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{js,mjs,cjs,json,yml,yaml,html,css}]
indent_size = 2

[*.md]
# Markdown 用两个空格做换行，不裁尾随空格
trim_trailing_whitespace = false
indent_size = 2

[*.{bat,cmd}]
# Windows 批处理必须 CRLF，否则 cmd 解析异常
end_of_line = crlf

[*.{sh}]
end_of_line = lf

[*.{ico,png,jpg,jpeg,bmp,zip,exe,dmg}]
insert_final_newline = false
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
